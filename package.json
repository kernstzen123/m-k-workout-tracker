{
  "name": "mk-workout",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.sw.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rules": "npm run rules:build:test && firebase emulators:exec --only firestore --project demo-mk-workout \"vitest run --config vitest.rules.config.mts\"",
    "test:e2e": "npm run rules:build:test && firebase emulators:exec --only auth,firestore --project demo-mk-workout \"playwright test\"",
    "rules:build": "tsx scripts/build-rules.mts",
    "rules:build:test": "tsx scripts/build-rules.mts --test",
    "emulators": "firebase emulators:start --project demo-mk-workout",
    "icons": "tsx scripts/generate-icons.mts",
    "deploy:rules": "npm run rules:build && firebase deploy --only firestore:rules,firestore:indexes"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "date-fns": "^4.4.0",
    "firebase": "^12.19.0",
    "lucide-react": "^1.49.0",
    "next": "^16.3.8",
    "papaparse": "^5.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "serwist": "^9.5.12",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.63.0",
    "@serwist/turbopack": "^9.5.12",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.4",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.3",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "eslint-config-prettier": "^10.1.8",
    "firebase-tools": "^15.32.1",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
